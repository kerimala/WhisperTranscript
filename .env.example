# Groq API Key - Get from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key - Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# AI Analysis Providers (at least one required for AI analysis feature)
# Kimi K2.5 - Get from https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here

# DeepSeek - Get from https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Default AI provider for analysis: 'kimi' or 'deepseek' (optional)
AI_ANALYSIS_PROVIDER=kimi

# HuggingFace token for speaker diarization (local mode only)
# Accept the pyannote license first: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=your_hf_token_here

# Local runtime selection: auto, mlx, cuda, vulkan, rocm, or cpu
WHISPER_ENGINE=auto

# Optional local model and compute overrides
WHISPER_MODEL=large-v3-turbo
# WHISPER_COMPUTE_TYPE=float16

# Required only when using a whisper.cpp Vulkan/ROCm build
# WHISPER_CPP_BIN=/path/to/whisper-cli
# WHISPER_CPP_MODEL=/path/to/ggml-large-v3-turbo.bin
